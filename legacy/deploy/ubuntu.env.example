# Garmetix generic Ubuntu deployment config
# Copy to: ~/.garmetix/ubuntu.env
# Keep this file private. Do not commit secrets.

# Remote install target
REMOTE_ROOT=/opt/garmetix
COMPOSE_PROJECT_NAME=garmetix
PUBLIC_DOMAIN=garmetix.aadwikafashion.in

# App ports bound on Ubuntu host loopback only
API_PORT=5080
WEB_PORT=3000
POSTGRES_PORT=5432

# PostgreSQL
POSTGRES_DB=garmetix
POSTGRES_USER=garmetix
# POSTGRES_PASSWORD should also exist in ~/.garmetix/.env.production
# POSTGRES_PASSWORD=change-me

# Database behavior
DATABASE_AUTO_MIGRATE=true
DATABASE_SCHEMA_BOOTSTRAP_MODE=Migrate
RESET_DATABASE_ON_DEPLOY=false

# Cloudflare settings
CLOUDFLARE_ENABLED=true
CLOUDFLARE_HOSTNAME=garmetix.aadwikafashion.in
CLOUDFLARE_SERVICE=http://web:3000
CLOUDFLARE_PROTOCOL=http2

# Cloudflare API details, needed if script should update DNS/public hostname or fetch connector token.
# Token permissions should include Zero Trust/Tunnel read+edit and DNS edit for this zone.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_TUNNEL_NAME=garmetix-ubuntu

# Default tunnel values. These can be overridden by deploy command: -tun <id> -tok <token>
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_TUNNEL_TOKEN=

# Tunnel aliases. Use: ./deploy/deploy-to-ubuntu.sh -s amit@192.168.11.126 -t T1
# New recommended variable names:
CLOUDFLARE_TUNNEL_1_ID=
CLOUDFLARE_TUNNEL_1_TOKEN=
CLOUDFLARE_TUNNEL_2_ID=
CLOUDFLARE_TUNNEL_2_TOKEN=

# Also supported for backward/typo compatibility:
# CLOUDFLARE_TUNNEL_T1_ID=
# CLOUDFLARE_TUNNEL_T1_TOKEN=
# CLOUDFLARE_T1_ID=
# CLOUDFLARE_T1_TOKEN=
# CloudFlairTunnel_1_ID=
# CloudFlairTunnel_1_TOKEN=
# CloudFlairTiurnnel_1_ID=
# CloudFlairTiurnnel_1_TOKEN=


# Optional saved passwords for fully automatic deploy.
# These are stored in plaintext, so keep ~/.garmetix/ubuntu.env chmod 600 and do not commit it.
# The deploy script can prompt once and save them automatically.
# Requires sshpass on the client for non-interactive SSH login: sudo apt-get install -y sshpass
SSH_PASSWORD=
SUDO_PASSWORD=
# Backward-compatible aliases also supported:
# UBUNTU_SSH_PASSWORD=
# UBUNTU_SUDO_PASSWORD=

# SSH / rsync options
SSH_OPTS="-o ServerAliveInterval=30 -o ServerAliveCountMax=4"
RSYNC_DELETE=true

# Optional: set to true if installing on a fresh Ubuntu Desktop/Server and you also want sleep disabled
DISABLE_SERVER_SLEEP=true

# Digital Bill CRM public invoice retention in days
DigitalBills__RetentionDays=180
DigitalBills__PublicBaseUrl=https://garmetix.aadwikafashion.in
WhatsApp__MetaWebhookVerifyToken=REPLACE_WITH_RANDOM_WEBHOOK_VERIFY_TOKEN
WhatsApp__MetaCloudApiBaseUrl=https://graph.facebook.com/v20.0

# DotMatrix bridge auto-install during deploy/run-production. Keep false if printer is not connected yet.
DOTMATRIX_BRIDGE_AUTO_INSTALL=false
