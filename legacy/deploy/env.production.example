# Copy to ~/.garmetix/.env.production
# Keep private. The deploy script copies it to /opt/garmetix/shared/env/.env.production if missing.

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:5080

POSTGRES_DB=garmetix
POSTGRES_USER=garmetix
POSTGRES_PASSWORD=change-this-password
POSTGRES_PORT=5432
ConnectionStrings__Default=Host=postgres;Port=5432;Database=garmetix;Username=garmetix;Password=change-this-password

DATABASE_AUTO_MIGRATE=true
DATABASE_SCHEMA_BOOTSTRAP_MODE=Migrate
RESET_DATABASE_ON_DEPLOY=false

API_PORT=5080
WEB_PORT=3000
HOST=0.0.0.0
PORT=3000
NITRO_HOST=0.0.0.0
NITRO_PORT=3000
NUXT_PUBLIC_API_BASE=/api

PUBLIC_DOMAIN=garmetix.aadwikafashion.in
CLOUDFLARE_ENABLED=true
CLOUDFLARE_HOSTNAME=garmetix.aadwikafashion.in
CLOUDFLARE_SERVICE=http://web:3000
CLOUDFLARE_PROTOCOL=http2
CLOUDFLARE_TUNNEL_ID=
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# Digital Bill CRM public invoice retention in days
DigitalBills__RetentionDays=180
DigitalBills__PublicBaseUrl=https://garmetix.aadwikafashion.in
WhatsApp__MetaWebhookVerifyToken=REPLACE_WITH_RANDOM_WEBHOOK_VERIFY_TOKEN
WhatsApp__MetaCloudApiBaseUrl=https://graph.facebook.com/v20.0

# Epson dot-matrix daily audit journal
# Recommended production mode: BridgeService. The API only creates DB queue rows;
# the Ubuntu host DotMatrix Bridge service reads the DB queue and prints through CUPS/lp.
DOTMATRIX_PRINTING_ENABLED=false
DOTMATRIX_PRINTING_RUN_WORKER=false
DOTMATRIX_PRINTER_NAME=EPSON_LX310
DOTMATRIX_OUTPUT_MODE=BridgeService
DOTMATRIX_SPOOL_DIRECTORY=/app/data/dotmatrix-spool
DOTMATRIX_TIMEZONE_ID=Asia/Kolkata
DOTMATRIX_LINE_WIDTH=136
DOTMATRIX_POLL_SECONDS=5
DOTMATRIX_RETRY_LIMIT=10

# DotMatrix bridge auto-install during deploy/run-production. Keep false if printer is not connected yet.
DOTMATRIX_BRIDGE_AUTO_INSTALL=false
