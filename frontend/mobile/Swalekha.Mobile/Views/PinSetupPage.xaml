<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
             xmlns:viewModels="clr-namespace:Swalekha.Mobile.ViewModels"
             x:Class="Swalekha.Mobile.Views.PinSetupPage"
             x:DataType="viewModels:PinSetupViewModel"
             Title="Quick PIN access"
             BackgroundColor="{AppThemeBinding Light={StaticResource SwalekhaBackground}, Dark={StaticResource SwalekhaBackgroundDark}}">

    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="18">

            <VerticalStackLayout Spacing="2">
                <Label Text="Set a 4-digit PIN" FontSize="20" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Secondary}}" />
                <Label Text="Unlock Swalekha with this PIN instead of your username and password every time. If your session expires, entering the correct PIN signs you back in automatically."
                       FontSize="13" TextColor="{StaticResource SwalekhaMuted}" />
            </VerticalStackLayout>

            <Border Padding="18" StrokeThickness="1" StrokeShape="RoundRectangle 16"
                    Stroke="{AppThemeBinding Light={StaticResource SwalekhaCardBorderLight}, Dark={StaticResource SwalekhaCardBorderDark}}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource SwalekhaSurfaceDark}}">
                <VerticalStackLayout Spacing="14">

                    <VerticalStackLayout Spacing="6">
                        <Label Text="New PIN" FontSize="13" TextColor="{StaticResource SwalekhaMuted}" />
                        <Entry Text="{Binding Pin}"
                               Keyboard="Numeric"
                               IsPassword="True"
                               MaxLength="4"
                               FontSize="22"
                               WidthRequest="140" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Confirm PIN" FontSize="13" TextColor="{StaticResource SwalekhaMuted}" />
                        <Entry Text="{Binding ConfirmPin}"
                               Keyboard="Numeric"
                               IsPassword="True"
                               MaxLength="4"
                               FontSize="22"
                               WidthRequest="140" />
                    </VerticalStackLayout>

                    <Label Text="{Binding ErrorMessage}"
                           IsVisible="{Binding HasError}"
                           TextColor="{StaticResource SwalekhaDanger}"
                           BackgroundColor="{AppThemeBinding Light={StaticResource SwalekhaDangerBg}, Dark={StaticResource SwalekhaDangerBgDark}}"
                           LineBreakMode="WordWrap"
                           Padding="10"
                           FontSize="12.5" />

                    <buttons:SfButton Text="Save PIN"
                                       Command="{Binding SaveCommand}"
                                       HeightRequest="46"
                                       CornerRadius="10"
                                       FontSize="15"
                                       Background="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Secondary}}"
                                       TextColor="{StaticResource White}" />

                    <buttons:SfButton Text="Skip for now"
                                       Command="{Binding SkipCommand}"
                                       IsVisible="{Binding IsChangeMode, Converter={StaticResource InvertedBoolConverter}}"
                                       HeightRequest="42"
                                       CornerRadius="10"
                                       FontSize="14"
                                       Background="Transparent"
                                       TextColor="{StaticResource SwalekhaMuted}" />

                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       Color="{StaticResource Secondary}" />

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
