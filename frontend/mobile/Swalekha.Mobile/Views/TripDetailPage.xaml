<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cards="clr-namespace:Syncfusion.Maui.Toolkit.Cards;assembly=Syncfusion.Maui.Toolkit"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
             xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Toolkit.TextInputLayout;assembly=Syncfusion.Maui.Toolkit"
             xmlns:viewModels="clr-namespace:Swalekha.Mobile.ViewModels"
             xmlns:models="clr-namespace:Swalekha.Mobile.Models"
             x:Class="Swalekha.Mobile.Views.TripDetailPage"
             x:DataType="viewModels:TripDetailViewModel"
             x:Name="PageRoot"
             Title="Trip"
             BackgroundColor="{AppThemeBinding Light={StaticResource SwalekhaBackground}, Dark={StaticResource SwalekhaBackgroundDark}}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Edit" Command="{Binding EditTripCommand}" />
    </ContentPage.ToolbarItems>

    <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="14">

                <cards:SfCardView Padding="16" BorderWidth="0" CornerRadius="14"
                              BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                              IsVisible="{Binding Trip, Converter={StaticResource NullableHasValueConverter}}">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding Trip.Name}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource White}" />
                        <Label Text="{Binding Trip.Destination}" FontSize="12" TextColor="{StaticResource SecondaryDarkText}"
                               IsVisible="{Binding Trip.Destination, Converter={StaticResource NullableHasValueConverter}}" />
                        <Label Text="{Binding Trip.SpentTotal, StringFormat='₹{0:N0}'}" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource White}" Margin="0,6,0,0" />
                        <Label Text="{Binding Trip.Budget, StringFormat='Budget: ₹{0:N0}'}" FontSize="11" TextColor="{StaticResource SecondaryDarkText}"
                               IsVisible="{Binding Trip.Budget, Converter={StaticResource NullableHasValueConverter}}" />
                        <Label Text="Closed" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource SecondaryDarkText}"
                               IsVisible="{Binding Trip.IsClosed}" />
                    </VerticalStackLayout>
                </cards:SfCardView>

                <Label Text="{Binding ErrorMessage}"
                       IsVisible="{Binding HasError}"
                       TextColor="{StaticResource SwalekhaDanger}"
                       BackgroundColor="{StaticResource SwalekhaDangerBg}"
                       Padding="10" FontSize="13" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <buttons:SfButton Grid.Column="0" Text="Add expense"
                                       Command="{Binding ToggleAddEntryCommand}"
                                       IsVisible="{Binding CanAddEntry}"
                                       HeightRequest="42" CornerRadius="8"
                                       Background="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Secondary}}"
                                       TextColor="{StaticResource White}" />
                    <buttons:SfButton Grid.Column="1" Text="{Binding CloseButtonText}"
                                       Command="{Binding ToggleCloseCommand}"
                                       HeightRequest="42" CornerRadius="8"
                                       Background="Transparent"
                                       Stroke="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Secondary}}"
                                       StrokeThickness="1"
                                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Secondary}}" />
                </Grid>

                <cards:SfCardView Padding="14" BorderWidth="0" CornerRadius="14"
                              IsVisible="{Binding IsAddingEntry}"
                              BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource SwalekhaSurfaceDark}}">
                    <VerticalStackLayout Spacing="10">
                        <inputLayout:SfTextInputLayout Hint="Category" ContainerType="Outlined">
                            <Entry Text="{Binding NewCategory}" Placeholder="Stay, food, transport..." />
                        </inputLayout:SfTextInputLayout>
                        <inputLayout:SfTextInputLayout Hint="Amount" ContainerType="Outlined">
                            <Entry Text="{Binding NewAmountText}" Keyboard="Numeric" />
                        </inputLayout:SfTextInputLayout>
                        <inputLayout:SfTextInputLayout Hint="Narration (optional)" ContainerType="Outlined">
                            <Entry Text="{Binding NewNarration}" />
                        </inputLayout:SfTextInputLayout>
                        <buttons:SfButton Text="Save expense"
                                           Command="{Binding AddEntryCommand}"
                                           HeightRequest="42" CornerRadius="8"
                                           Background="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Secondary}}"
                                           TextColor="{StaticResource White}" />
                    </VerticalStackLayout>
                </cards:SfCardView>

                <Label Text="Expenses" FontSize="13" FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Secondary}}" />

                <CollectionView ItemsSource="{Binding Entries}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:SwalekhaExpenseEntryDto">
                            <cards:SfCardView Padding="12" Margin="0,0,0,6" BorderWidth="0" CornerRadius="10"
                                          BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource SwalekhaSurfaceDark}}">
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <VerticalStackLayout Grid.Column="0" Spacing="1">
                                        <Label Text="{Binding Category}" FontSize="12" FontAttributes="Bold" />
                                        <Label Text="{Binding Narration}" FontSize="11" TextColor="{StaticResource SwalekhaMuted}"
                                               IsVisible="{Binding Narration, Converter={StaticResource NullableHasValueConverter}}" />
                                        <Label Text="{Binding EntryDate, StringFormat='{0:dd MMM yyyy}'}" FontSize="10" TextColor="{StaticResource SwalekhaMuted}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding Amount, StringFormat='₹{0:N0}'}"
                                           FontSize="13" FontAttributes="Bold" VerticalOptions="Center" Margin="0,0,10,0" />
                                    <Button Grid.Column="2" Text="Delete" FontSize="11"
                                            Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.DeleteEntryCommand}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="Transparent" TextColor="{StaticResource SwalekhaDanger}"
                                            Padding="0" VerticalOptions="Center" />
                                </Grid>
                            </cards:SfCardView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
