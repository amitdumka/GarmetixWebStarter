<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cards="clr-namespace:Syncfusion.Maui.Toolkit.Cards;assembly=Syncfusion.Maui.Toolkit"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
             xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Toolkit.TextInputLayout;assembly=Syncfusion.Maui.Toolkit"
             xmlns:viewModels="clr-namespace:Swalekha.Mobile.ViewModels"
             xmlns:models="clr-namespace:Swalekha.Mobile.Models"
             x:Class="Swalekha.Mobile.Views.NotesPage"
             x:DataType="viewModels:NotesViewModel"
             x:Name="PageRoot"
             Title="Notes"
             BackgroundColor="{AppThemeBinding Light={StaticResource SwalekhaBackground}, Dark={StaticResource SwalekhaBackgroundDark}}">

    <Grid RowDefinitions="*,Auto">

        <RefreshView Grid.Row="0" Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy}">
            <ScrollView>
                <VerticalStackLayout Padding="16" Spacing="12">

                    <inputLayout:SfTextInputLayout Hint="Search notes" ContainerType="Outlined">
                        <Entry Text="{Binding SearchText}" Completed="OnSearchCompleted" />
                    </inputLayout:SfTextInputLayout>

                    <Label Text="{Binding ErrorMessage}"
                           IsVisible="{Binding HasError}"
                           TextColor="{StaticResource SwalekhaDanger}"
                           BackgroundColor="{StaticResource SwalekhaDangerBg}"
                           Padding="10" FontSize="13" />

                    <cards:SfCard Padding="14" StrokeThickness="0" CornerRadius="14"
                                  IsVisible="{Binding IsEditingForm}"
                                  BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource SwalekhaSurfaceDark}}">
                        <VerticalStackLayout Spacing="10">
                            <inputLayout:SfTextInputLayout Hint="Title" ContainerType="Outlined">
                                <Entry Text="{Binding FormTitle}" />
                            </inputLayout:SfTextInputLayout>
                            <inputLayout:SfTextInputLayout Hint="Content" ContainerType="Outlined">
                                <Editor Text="{Binding FormContent}" HeightRequest="100" AutoSize="TextChanges" />
                            </inputLayout:SfTextInputLayout>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <inputLayout:SfTextInputLayout Grid.Column="0" Hint="Folder (optional)" ContainerType="Outlined">
                                    <Entry Text="{Binding FormFolder}" />
                                </inputLayout:SfTextInputLayout>
                                <inputLayout:SfTextInputLayout Grid.Column="1" Hint="Tags (optional)" ContainerType="Outlined">
                                    <Entry Text="{Binding FormTags}" Placeholder="comma, separated" />
                                </inputLayout:SfTextInputLayout>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Pin note" VerticalOptions="Center" />
                                <Switch Grid.Column="1" IsToggled="{Binding FormIsPinned}" />
                            </Grid>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <buttons:SfButton Grid.Column="0" Text="Save"
                                                   Command="{Binding SaveNoteCommand}"
                                                   HeightRequest="42" CornerRadius="8"
                                                   Background="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Secondary}}"
                                                   TextColor="{StaticResource White}" />
                                <buttons:SfButton Grid.Column="1" Text="Cancel"
                                                   Command="{Binding CancelFormCommand}"
                                                   HeightRequest="42" CornerRadius="8"
                                                   Background="Transparent"
                                                   TextColor="{StaticResource SwalekhaMuted}" />
                            </Grid>
                        </VerticalStackLayout>
                    </cards:SfCard>

                    <Label Text="No notes yet."
                           IsVisible="{Binding HasNoNotes}"
                           FontSize="13" TextColor="{StaticResource SwalekhaMuted}"
                           HorizontalOptions="Center" Margin="0,24,0,0" />

                    <CollectionView ItemsSource="{Binding Notes}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:SwalekhaPersonalNoteDto">
                                <cards:SfCard Padding="14" Margin="0,0,0,8" StrokeThickness="0" CornerRadius="12"
                                              BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource SwalekhaSurfaceDark}}">
                                    <cards:SfCard.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.EditNoteCommand}"
                                                               CommandParameter="{Binding .}" />
                                    </cards:SfCard.GestureRecognizers>
                                    <VerticalStackLayout Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0" Text="{Binding Title}" FontSize="14" FontAttributes="Bold" />
                                            <Label Grid.Column="1" Text="Pinned" FontSize="10" FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Secondary}}"
                                                   IsVisible="{Binding IsPinned}" />
                                        </Grid>
                                        <Label Text="{Binding Content}" FontSize="12" LineBreakMode="TailTruncation" MaxLines="2" />
                                        <Label Text="{Binding Folder}" FontSize="10" TextColor="{StaticResource SwalekhaMuted}"
                                               IsVisible="{Binding Folder, Converter={StaticResource NullableHasValueConverter}}" />
                                        <Button Text="Delete" FontSize="11" HorizontalOptions="End"
                                                Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.DeleteNoteCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="Transparent" TextColor="{StaticResource SwalekhaDanger}"
                                                Padding="0" />
                                    </VerticalStackLayout>
                                </cards:SfCard>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <buttons:SfButton Grid.Row="1" Text="+ New note"
                           Command="{Binding ShowAddFormCommand}"
                           Margin="16" HeightRequest="48" CornerRadius="10"
                           Background="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Secondary}}"
                           TextColor="{StaticResource White}" />
    </Grid>
</ContentPage>
