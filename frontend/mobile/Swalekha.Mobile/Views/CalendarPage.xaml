<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
             xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Toolkit.TextInputLayout;assembly=Syncfusion.Maui.Toolkit"
             xmlns:viewModels="clr-namespace:Swalekha.Mobile.ViewModels"
             xmlns:models="clr-namespace:Swalekha.Mobile.Models"
             x:Class="Swalekha.Mobile.Views.CalendarPage"
             x:DataType="viewModels:CalendarViewModel"
             x:Name="PageRoot"
             Title="Calendar"
             BackgroundColor="{AppThemeBinding Light={StaticResource SwalekhaBackground}, Dark={StaticResource SwalekhaBackgroundDark}}">

    <Grid RowDefinitions="*,Auto">

        <RefreshView Grid.Row="0" Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy}">
            <ScrollView>
                <VerticalStackLayout Padding="16" Spacing="12">

                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Button Grid.Column="0" Text="&#8249;" Command="{Binding PreviousMonthCommand}"
                                BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Secondary}}" FontSize="18" />
                        <Label Grid.Column="1" Text="{Binding MonthLabel}" FontSize="15" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                        <Button Grid.Column="2" Text="&#8250;" Command="{Binding NextMonthCommand}"
                                BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Secondary}}" FontSize="18" />
                    </Grid>

                    <Label Text="{Binding ErrorMessage}"
                           IsVisible="{Binding HasError}"
                           TextColor="{StaticResource SwalekhaDanger}"
                           BackgroundColor="{StaticResource SwalekhaDangerBg}"
                           Padding="10" FontSize="13" />

                    <Border Padding="14" StrokeThickness="0" StrokeShape="RoundRectangle 14"
                                  IsVisible="{Binding IsAddingAppointment}"
                                  BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource SwalekhaSurfaceDark}}">
                        <VerticalStackLayout Spacing="10">
                            <inputLayout:SfTextInputLayout Hint="Title" ContainerType="Outlined">
                                <Entry Text="{Binding NewTitle}" />
                            </inputLayout:SfTextInputLayout>
                            <inputLayout:SfTextInputLayout Hint="Date (YYYY-MM-DD)" ContainerType="Outlined">
                                <Entry Text="{Binding NewDateText}" />
                            </inputLayout:SfTextInputLayout>
                            <inputLayout:SfTextInputLayout Hint="Location (optional)" ContainerType="Outlined">
                                <Entry Text="{Binding NewLocation}" />
                            </inputLayout:SfTextInputLayout>
                            <buttons:SfButton Text="Save appointment"
                                               Command="{Binding AddAppointmentCommand}"
                                               HeightRequest="42" CornerRadius="8"
                                               Background="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Secondary}}"
                                               TextColor="{StaticResource White}" />
                        </VerticalStackLayout>
                    </Border>

                    <Label Text="Nothing on the calendar this month."
                           IsVisible="{Binding HasNoEvents}"
                           FontSize="13" TextColor="{StaticResource SwalekhaMuted}"
                           HorizontalOptions="Center" Margin="0,24,0,0" />

                    <CollectionView ItemsSource="{Binding Events}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:SwalekhaCalendarEventDto">
                                <Border Padding="12" Margin="0,0,0,6" StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                              BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource SwalekhaSurfaceDark}}">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                        <Label Grid.Column="0" Text="{Binding Date, StringFormat='{0:dd}'}" FontSize="18" FontAttributes="Bold" WidthRequest="34"
                                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Secondary}}" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="1">
                                            <Label Text="{Binding Title}" FontSize="12" FontAttributes="Bold" />
                                            <Label Text="{Binding EventType}" FontSize="10" TextColor="{StaticResource SwalekhaMuted}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2" Text="{Binding Amount, StringFormat='₹{0:N0}'}"
                                               IsVisible="{Binding Amount, Converter={StaticResource NullableHasValueConverter}}"
                                               FontSize="12" FontAttributes="Bold" VerticalOptions="Center" Margin="0,0,8,0" />
                                        <Button Grid.Column="3" Text="Delete" FontSize="11"
                                                IsVisible="{Binding EventType, Converter={StaticResource StringEqualsConverter}, ConverterParameter='Appointment'}"
                                                Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.DeleteEventCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="Transparent" TextColor="{StaticResource SwalekhaDanger}"
                                                Padding="0" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <buttons:SfButton Grid.Row="1" Text="+ New appointment"
                           Command="{Binding ToggleAddAppointmentCommand}"
                           Margin="16" HeightRequest="48" CornerRadius="10"
                           Background="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Secondary}}"
                           TextColor="{StaticResource White}" />
    </Grid>
</ContentPage>
