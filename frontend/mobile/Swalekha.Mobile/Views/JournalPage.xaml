<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cards="clr-namespace:Syncfusion.Maui.Toolkit.Cards;assembly=Syncfusion.Maui.Toolkit"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
             xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Toolkit.TextInputLayout;assembly=Syncfusion.Maui.Toolkit"
             xmlns:viewModels="clr-namespace:Swalekha.Mobile.ViewModels"
             xmlns:models="clr-namespace:Swalekha.Mobile.Models"
             x:Class="Swalekha.Mobile.Views.JournalPage"
             x:DataType="viewModels:JournalViewModel"
             x:Name="PageRoot"
             Title="Journal"
             BackgroundColor="{AppThemeBinding Light={StaticResource SwalekhaBackground}, Dark={StaticResource SwalekhaBackgroundDark}}">

    <Grid RowDefinitions="*,Auto">

        <RefreshView Grid.Row="0" Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy}">
            <ScrollView>
                <VerticalStackLayout Padding="16" Spacing="12">

                    <Label Text="{Binding ErrorMessage}"
                           IsVisible="{Binding HasError}"
                           TextColor="{StaticResource SwalekhaDanger}"
                           BackgroundColor="{StaticResource SwalekhaDangerBg}"
                           Padding="10" FontSize="13" />

                    <cards:SfCardView Padding="14" BorderWidth="0" CornerRadius="14"
                                  IsVisible="{Binding IsEditingForm}"
                                  BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource SwalekhaSurfaceDark}}">
                        <VerticalStackLayout Spacing="10">
                            <inputLayout:SfTextInputLayout Hint="Title (optional)" ContainerType="Outlined">
                                <Entry Text="{Binding FormTitle}" />
                            </inputLayout:SfTextInputLayout>
                            <inputLayout:SfTextInputLayout Hint="What's on your mind" ContainerType="Outlined">
                                <Editor Text="{Binding FormContent}" HeightRequest="120" AutoSize="TextChanges" />
                            </inputLayout:SfTextInputLayout>
                            <inputLayout:SfTextInputLayout Hint="Mood (optional)" ContainerType="Outlined">
                                <Entry Text="{Binding FormMood}" Placeholder="Happy, tired, grateful..." />
                            </inputLayout:SfTextInputLayout>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <buttons:SfButton Grid.Column="0" Text="Save"
                                                   Command="{Binding SaveEntryCommand}"
                                                   HeightRequest="42" CornerRadius="8"
                                                   Background="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Secondary}}"
                                                   TextColor="{StaticResource White}" />
                                <buttons:SfButton Grid.Column="1" Text="Cancel"
                                                   Command="{Binding CancelFormCommand}"
                                                   HeightRequest="42" CornerRadius="8"
                                                   Background="Transparent"
                                                   TextColor="{StaticResource SwalekhaMuted}" />
                            </Grid>
                        </VerticalStackLayout>
                    </cards:SfCardView>

                    <Label Text="No journal entries yet."
                           IsVisible="{Binding HasNoEntries}"
                           FontSize="13" TextColor="{StaticResource SwalekhaMuted}"
                           HorizontalOptions="Center" Margin="0,24,0,0" />

                    <CollectionView ItemsSource="{Binding Entries}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:SwalekhaJournalEntryDto">
                                <cards:SfCardView Padding="14" Margin="0,0,0,8" BorderWidth="0" CornerRadius="12"
                                              BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource SwalekhaSurfaceDark}}">
                                    <cards:SfCardView.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.EditEntryCommand}"
                                                               CommandParameter="{Binding .}" />
                                    </cards:SfCardView.GestureRecognizers>
                                    <VerticalStackLayout Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0" Text="{Binding EntryDate, StringFormat='{0:dd MMM yyyy}'}" FontSize="11" TextColor="{StaticResource SwalekhaMuted}" />
                                            <Label Grid.Column="1" Text="{Binding Mood}" FontSize="11" TextColor="{StaticResource SwalekhaMuted}"
                                                   IsVisible="{Binding Mood, Converter={StaticResource NullableHasValueConverter}}" />
                                        </Grid>
                                        <Label Text="{Binding Title}" FontSize="14" FontAttributes="Bold"
                                               IsVisible="{Binding Title, Converter={StaticResource NullableHasValueConverter}}" />
                                        <Label Text="{Binding Content}" FontSize="12" LineBreakMode="TailTruncation" MaxLines="3" />
                                        <Button Text="Delete" FontSize="11" HorizontalOptions="End"
                                                Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.DeleteEntryCommand}"
                                                CommandParameter="{Binding .}"
                                                BackgroundColor="Transparent" TextColor="{StaticResource SwalekhaDanger}"
                                                Padding="0" />
                                    </VerticalStackLayout>
                                </cards:SfCardView>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <buttons:SfButton Grid.Row="1" Text="+ New entry"
                           Command="{Binding ShowAddFormCommand}"
                           Margin="16" HeightRequest="48" CornerRadius="10"
                           Background="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Secondary}}"
                           TextColor="{StaticResource White}" />
    </Grid>
</ContentPage>
