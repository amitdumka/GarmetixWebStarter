<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cards="clr-namespace:Syncfusion.Maui.Toolkit.Cards;assembly=Syncfusion.Maui.Toolkit"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
             xmlns:viewModels="clr-namespace:Swalekha.Mobile.ViewModels"
             xmlns:models="clr-namespace:Swalekha.Mobile.Models"
             x:Class="Swalekha.Mobile.Views.SharesPage"
             x:DataType="viewModels:SharesViewModel"
             Title="Shares &amp; stocks"
             BackgroundColor="{AppThemeBinding Light={StaticResource SwalekhaBackground}, Dark={StaticResource SwalekhaBackgroundDark}}">

    <Grid RowDefinitions="*,Auto">

        <RefreshView Grid.Row="0" Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy}">
            <ScrollView>
                <VerticalStackLayout Padding="16" Spacing="12">

                    <cards:SfCardView Padding="16" BorderWidth="0" CornerRadius="14"
                                  BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Current value" FontSize="12" TextColor="{StaticResource SecondaryDarkText}" />
                            <Label Text="{Binding TotalCurrentValue, StringFormat='₹{0:N0}'}" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource White}" />
                            <Label Text="{Binding TotalInvested, StringFormat='Invested: ₹{0:N0}'}" FontSize="11" TextColor="{StaticResource SecondaryDarkText}" />
                        </VerticalStackLayout>
                    </cards:SfCardView>

                    <Label Text="{Binding ErrorMessage}"
                           IsVisible="{Binding HasError}"
                           TextColor="{StaticResource SwalekhaDanger}"
                           BackgroundColor="{StaticResource SwalekhaDangerBg}"
                           Padding="10" FontSize="13" />

                    <Label Text="No holdings yet."
                           IsVisible="{Binding HasNoHoldings}"
                           FontSize="13" TextColor="{StaticResource SwalekhaMuted}"
                           HorizontalOptions="Center" Margin="0,24,0,0" />

                    <CollectionView x:Name="HoldingsList"
                                    ItemsSource="{Binding Holdings}"
                                    SelectionMode="Single"
                                    SelectionChanged="OnHoldingSelected">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:SwalekhaShareHoldingDto">
                                <cards:SfCardView Padding="14" Margin="0,0,0,8" BorderWidth="0" CornerRadius="12"
                                              BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource SwalekhaSurfaceDark}}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <VerticalStackLayout Grid.Column="0" Spacing="1">
                                            <Label Text="{Binding Symbol}" FontSize="14" FontAttributes="Bold" />
                                            <Label FontSize="11" TextColor="{StaticResource SwalekhaMuted}">
                                                <Label.Text>
                                                    <Binding Path="CurrentQuantity" StringFormat="{}{0:N0} shares" />
                                                </Label.Text>
                                            </Label>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="End" Spacing="1">
                                            <Label Text="{Binding CurrentValue, StringFormat='₹{0:N0}'}"
                                                   IsVisible="{Binding CurrentValue, Converter={StaticResource NullableHasValueConverter}}"
                                                   FontSize="15" FontAttributes="Bold" HorizontalOptions="End"
                                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Secondary}}" />
                                            <Label Text="{Binding UnrealizedPnLPercent, StringFormat='{0:N1}%'}"
                                                   IsVisible="{Binding UnrealizedPnLPercent, Converter={StaticResource NullableHasValueConverter}}"
                                                   FontSize="11" HorizontalOptions="End" TextColor="{StaticResource SwalekhaSuccess}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </cards:SfCardView>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <buttons:SfButton Grid.Row="1" Text="+ Add holding"
                           Command="{Binding AddHoldingCommand}"
                           Margin="16" HeightRequest="48" CornerRadius="10"
                           Background="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Secondary}}"
                           TextColor="{StaticResource White}" />
    </Grid>
</ContentPage>
