<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cards="clr-namespace:Syncfusion.Maui.Toolkit.Cards;assembly=Syncfusion.Maui.Toolkit"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
             xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Toolkit.TextInputLayout;assembly=Syncfusion.Maui.Toolkit"
             xmlns:viewModels="clr-namespace:Swalekha.Mobile.ViewModels"
             x:Class="Swalekha.Mobile.Views.LoginPage"
             x:DataType="viewModels:LoginViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource SwalekhaBackground}, Dark={StaticResource SwalekhaBackgroundDark}}">

    <!-- Grid star rows (not a plain centered stack) so the form's vertical position scales with
         actual screen height at runtime instead of a fixed margin - reads correctly from small
         phones to tall/large-screen devices instead of only being tuned for one test device. -->
    <Grid RowDefinitions="0.8*,Auto,1.2*" Padding="24,0">

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="0"
                                  MaximumWidthRequest="420"
                                  HorizontalOptions="Center">

                <VerticalStackLayout Spacing="4" Margin="4,0,4,24" HorizontalOptions="Center">
                    <Label Text="Swalekha"
                           FontSize="26"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Secondary}}" />
                    <Label Text="Your personal finance ledger"
                           FontSize="13"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           TextColor="{StaticResource SwalekhaMuted}" />
                </VerticalStackLayout>

                <cards:SfCardView Padding="22" BorderWidth="1" CornerRadius="18"
                          BorderColor="{AppThemeBinding Light={StaticResource SwalekhaCardBorderLight}, Dark={StaticResource SwalekhaCardBorderDark}}"
                          BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource SwalekhaSurfaceDark}}">
                    <cards:SfCardView.Shadow>
                        <Shadow Brush="Black" Opacity="0.22" Radius="16" Offset="0,6" />
                    </cards:SfCardView.Shadow>
                    <VerticalStackLayout Spacing="14">

                        <inputLayout:SfTextInputLayout Hint="Username" ContainerType="Outlined">
                            <Entry Text="{Binding UserName}"
                                   Keyboard="Email"
                                   ReturnType="Next"
                                   FontSize="15"
                                   IsSpellCheckEnabled="False"
                                   IsTextPredictionEnabled="False" />
                        </inputLayout:SfTextInputLayout>

                        <inputLayout:SfTextInputLayout Hint="Password" ContainerType="Outlined">
                            <Entry Text="{Binding Password}"
                                   IsPassword="True"
                                   FontSize="15"
                                   ReturnType="Go"
                                   ReturnCommand="{Binding LoginCommand}" />
                        </inputLayout:SfTextInputLayout>

                        <Label Text="{Binding ErrorMessage}"
                               IsVisible="{Binding HasError}"
                               TextColor="{StaticResource SwalekhaDanger}"
                               BackgroundColor="{AppThemeBinding Light={StaticResource SwalekhaDangerBg}, Dark={StaticResource SwalekhaDangerBgDark}}"
                               LineBreakMode="WordWrap"
                               Padding="10"
                               FontSize="12.5" />

                        <buttons:SfButton Text="Sign in"
                                           Command="{Binding LoginCommand}"
                                           HeightRequest="46"
                                           CornerRadius="10"
                                           FontSize="15"
                                           Background="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Secondary}}"
                                           TextColor="{StaticResource White}" />

                        <ActivityIndicator IsRunning="{Binding IsBusy}"
                                           IsVisible="{Binding IsBusy}"
                                           Color="{StaticResource Secondary}" />

                    </VerticalStackLayout>
                </cards:SfCardView>

                <Label Text="Owner accounts only."
                       FontSize="12"
                       TextColor="{StaticResource SwalekhaMuted}"
                       HorizontalOptions="Center"
                       Margin="0,18,0,0" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
