<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cards="clr-namespace:Syncfusion.Maui.Toolkit.Cards;assembly=Syncfusion.Maui.Toolkit"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
             xmlns:viewModels="clr-namespace:Swalekha.Mobile.ViewModels"
             xmlns:models="clr-namespace:Swalekha.Mobile.Models"
             x:Class="Swalekha.Mobile.Views.ContactsPage"
             x:DataType="viewModels:ContactsViewModel"
             Title="Contacts"
             BackgroundColor="{AppThemeBinding Light={StaticResource SwalekhaBackground}, Dark={StaticResource SwalekhaBackgroundDark}}">

    <Grid RowDefinitions="*,Auto">

        <RefreshView Grid.Row="0" Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy}">
            <ScrollView>
                <VerticalStackLayout Padding="16" Spacing="12">

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <cards:SfCard Grid.Column="0" Padding="14" StrokeThickness="0" CornerRadius="12"
                                      BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource SwalekhaSurfaceDark}}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Owed to you" FontSize="11" TextColor="{StaticResource SwalekhaMuted}" />
                                <Label Text="{Binding TotalOwedToYou, StringFormat='₹{0:N0}'}" FontSize="17" FontAttributes="Bold" TextColor="{StaticResource SwalekhaSuccess}" />
                            </VerticalStackLayout>
                        </cards:SfCard>
                        <cards:SfCard Grid.Column="1" Padding="14" StrokeThickness="0" CornerRadius="12"
                                      BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource SwalekhaSurfaceDark}}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="You owe" FontSize="11" TextColor="{StaticResource SwalekhaMuted}" />
                                <Label Text="{Binding TotalYouOwe, StringFormat='₹{0:N0}'}" FontSize="17" FontAttributes="Bold" TextColor="{StaticResource SwalekhaDanger}" />
                            </VerticalStackLayout>
                        </cards:SfCard>
                    </Grid>

                    <Label Text="{Binding ErrorMessage}"
                           IsVisible="{Binding HasError}"
                           TextColor="{StaticResource SwalekhaDanger}"
                           BackgroundColor="{StaticResource SwalekhaDangerBg}"
                           Padding="10" FontSize="13" />

                    <Label Text="No contacts yet. Tap + to add your first one."
                           IsVisible="{Binding HasNoContacts}"
                           FontSize="13" TextColor="{StaticResource SwalekhaMuted}"
                           HorizontalOptions="Center" Margin="0,24,0,0" />

                    <CollectionView x:Name="ContactsList"
                                    ItemsSource="{Binding Contacts}"
                                    SelectionMode="Single"
                                    SelectionChanged="OnContactSelected">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:SwalekhaContactDto">
                                <cards:SfCard Padding="14" Margin="0,0,0,8" StrokeThickness="0" CornerRadius="12"
                                              BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource SwalekhaSurfaceDark}}">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <VerticalStackLayout Grid.Column="0" Spacing="1">
                                            <Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold" />
                                            <Label Text="{Binding Relationship}" FontSize="11" TextColor="{StaticResource SwalekhaMuted}"
                                                   IsVisible="{Binding Relationship, Converter={StaticResource NullableHasValueConverter}}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" Text="{Binding Balance, StringFormat='₹{0:N0}'}"
                                               FontSize="15" FontAttributes="Bold" VerticalOptions="Center"
                                               TextColor="{StaticResource SwalekhaSuccess}" />
                                    </Grid>
                                </cards:SfCard>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <buttons:SfButton Grid.Row="1" Text="+ Add contact"
                           Command="{Binding AddContactCommand}"
                           Margin="16" HeightRequest="48" CornerRadius="10"
                           Background="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Secondary}}"
                           TextColor="{StaticResource White}" />
    </Grid>
</ContentPage>
