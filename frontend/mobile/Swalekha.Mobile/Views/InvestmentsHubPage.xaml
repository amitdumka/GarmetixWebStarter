<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cards="clr-namespace:Syncfusion.Maui.Toolkit.Cards;assembly=Syncfusion.Maui.Toolkit"
             xmlns:viewModels="clr-namespace:Swalekha.Mobile.ViewModels"
             x:Class="Swalekha.Mobile.Views.InvestmentsHubPage"
             x:DataType="viewModels:InvestmentsHubViewModel"
             Title="Investments"
             BackgroundColor="{AppThemeBinding Light={StaticResource SwalekhaBackground}, Dark={StaticResource SwalekhaBackgroundDark}}">

    <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="12">

                <Label Text="{Binding ErrorMessage}"
                       IsVisible="{Binding HasError}"
                       TextColor="{StaticResource SwalekhaDanger}"
                       BackgroundColor="{StaticResource SwalekhaDangerBg}"
                       Padding="10" FontSize="13" />

                <cards:SfCardView Padding="16" BorderWidth="0" CornerRadius="14"
                              BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource SwalekhaSurfaceDark}}">
                    <cards:SfCardView.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenFixedDepositsCommand}" />
                    </cards:SfCardView.GestureRecognizers>
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="1">
                            <Label Text="Fixed deposits" FontSize="14" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Secondary}}" />
                            <Label FontSize="11" TextColor="{StaticResource SwalekhaMuted}">
                                <Label.Text>
                                    <Binding Path="ActiveFixedDepositCount" StringFormat="{}{0} active" />
                                </Label.Text>
                            </Label>
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="{Binding ActiveFixedDepositPrincipal, StringFormat='₹{0:N0}'}"
                               FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>
                </cards:SfCardView>

                <cards:SfCardView Padding="16" BorderWidth="0" CornerRadius="14"
                              BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource SwalekhaSurfaceDark}}">
                    <cards:SfCardView.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenRecurringDepositsCommand}" />
                    </cards:SfCardView.GestureRecognizers>
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="1">
                            <Label Text="Recurring deposits" FontSize="14" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Secondary}}" />
                            <Label FontSize="11" TextColor="{StaticResource SwalekhaMuted}">
                                <Label.Text>
                                    <Binding Path="ActiveRecurringDepositCount" StringFormat="{}{0} active" />
                                </Label.Text>
                            </Label>
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="{Binding ActiveRecurringDepositMonthlyCommitment, StringFormat='₹{0:N0}/mo'}"
                               FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>
                </cards:SfCardView>

                <cards:SfCardView Padding="16" BorderWidth="0" CornerRadius="14"
                              BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource SwalekhaSurfaceDark}}">
                    <cards:SfCardView.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenMutualFundsCommand}" />
                    </cards:SfCardView.GestureRecognizers>
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="1">
                            <Label Text="Mutual funds" FontSize="14" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Secondary}}" />
                            <Label FontSize="11" TextColor="{StaticResource SwalekhaMuted}">
                                <Label.Text>
                                    <Binding Path="ActiveMutualFundCount" StringFormat="{}{0} active" />
                                </Label.Text>
                            </Label>
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="{Binding MutualFundCurrentValue, StringFormat='₹{0:N0}'}"
                               FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>
                </cards:SfCardView>

                <cards:SfCardView Padding="16" BorderWidth="0" CornerRadius="14"
                              BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource SwalekhaSurfaceDark}}">
                    <cards:SfCardView.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenSharesCommand}" />
                    </cards:SfCardView.GestureRecognizers>
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="1">
                            <Label Text="Shares &amp; stocks" FontSize="14" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Secondary}}" />
                            <Label FontSize="11" TextColor="{StaticResource SwalekhaMuted}">
                                <Label.Text>
                                    <Binding Path="ActiveShareCount" StringFormat="{}{0} holdings" />
                                </Label.Text>
                            </Label>
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="{Binding ShareCurrentValue, StringFormat='₹{0:N0}'}"
                               FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>
                </cards:SfCardView>

                <cards:SfCardView Padding="16" BorderWidth="0" CornerRadius="14"
                              BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource SwalekhaSurfaceDark}}">
                    <cards:SfCardView.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenOtherAssetsCommand}" />
                    </cards:SfCardView.GestureRecognizers>
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="1">
                            <Label Text="Other assets" FontSize="14" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Secondary}}" />
                            <Label Text="PPF, EPF, NPS, Gold" FontSize="11" TextColor="{StaticResource SwalekhaMuted}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="1" Text="{Binding OtherAssetValue, StringFormat='₹{0:N0}'}"
                               FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>
                </cards:SfCardView>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
