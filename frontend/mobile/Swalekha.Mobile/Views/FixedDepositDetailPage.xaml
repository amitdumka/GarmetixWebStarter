<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cards="clr-namespace:Syncfusion.Maui.Toolkit.Cards;assembly=Syncfusion.Maui.Toolkit"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
             xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Toolkit.TextInputLayout;assembly=Syncfusion.Maui.Toolkit"
             xmlns:viewModels="clr-namespace:Swalekha.Mobile.ViewModels"
             x:Class="Swalekha.Mobile.Views.FixedDepositDetailPage"
             x:DataType="viewModels:FixedDepositDetailViewModel"
             Title="Fixed deposit"
             BackgroundColor="{AppThemeBinding Light={StaticResource SwalekhaBackground}, Dark={StaticResource SwalekhaBackgroundDark}}">

    <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="14">

                <cards:SfCardView Padding="16" BorderWidth="0" CornerRadius="14"
                              BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                              IsVisible="{Binding Deposit, Converter={StaticResource NullableHasValueConverter}}">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding Deposit.BankName}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource White}" />
                        <Label Text="{Binding Deposit.FdNumber}" FontSize="12" TextColor="{StaticResource SecondaryDarkText}"
                               IsVisible="{Binding Deposit.FdNumber, Converter={StaticResource NullableHasValueConverter}}" />
                        <Label Text="{Binding Deposit.PrincipalAmount, StringFormat='₹{0:N0}'}" FontSize="24" FontAttributes="Bold" TextColor="{StaticResource White}" Margin="0,6,0,0" />
                        <Label Text="{Binding Deposit.InterestRatePercent, StringFormat='{0}% interest'}" FontSize="11" TextColor="{StaticResource SecondaryDarkText}" />
                        <Label Text="{Binding Deposit.MaturityDate, StringFormat='Matures {0:dd MMM yyyy}'}" FontSize="11" TextColor="{StaticResource SecondaryDarkText}" />
                        <Label Text="Matured" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource SecondaryDarkText}"
                               IsVisible="{Binding Deposit.IsClosed}" />
                    </VerticalStackLayout>
                </cards:SfCardView>

                <Label Text="{Binding ErrorMessage}"
                       IsVisible="{Binding HasError}"
                       TextColor="{StaticResource SwalekhaDanger}"
                       BackgroundColor="{StaticResource SwalekhaDangerBg}"
                       Padding="10" FontSize="13" />

                <buttons:SfButton Text="Mark matured"
                                   Command="{Binding ToggleMaturingCommand}"
                                   IsVisible="{Binding CanMarkMatured}"
                                   HeightRequest="42" CornerRadius="8"
                                   Background="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Secondary}}"
                                   TextColor="{StaticResource White}" />

                <cards:SfCardView Padding="14" BorderWidth="0" CornerRadius="14"
                              IsVisible="{Binding IsMaturing}"
                              BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource SwalekhaSurfaceDark}}">
                    <VerticalStackLayout Spacing="10">
                        <inputLayout:SfTextInputLayout Hint="Maturity amount credited" ContainerType="Outlined">
                            <Entry Text="{Binding MaturityAmountText}" Keyboard="Numeric" />
                        </inputLayout:SfTextInputLayout>
                        <Label Text="If a bank account is linked, it will be credited automatically."
                               FontSize="11" TextColor="{StaticResource SwalekhaMuted}" />
                        <buttons:SfButton Text="Confirm matured"
                                           Command="{Binding ConfirmMaturedCommand}"
                                           HeightRequest="42" CornerRadius="8"
                                           Background="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Secondary}}"
                                           TextColor="{StaticResource White}" />
                    </VerticalStackLayout>
                </cards:SfCardView>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
