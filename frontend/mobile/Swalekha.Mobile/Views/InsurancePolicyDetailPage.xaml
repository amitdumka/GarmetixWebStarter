<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
             xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Toolkit.TextInputLayout;assembly=Syncfusion.Maui.Toolkit"
             xmlns:viewModels="clr-namespace:Swalekha.Mobile.ViewModels"
             x:Class="Swalekha.Mobile.Views.InsurancePolicyDetailPage"
             x:DataType="viewModels:InsurancePolicyDetailViewModel"
             Title="Policy"
             BackgroundColor="{AppThemeBinding Light={StaticResource SwalekhaBackground}, Dark={StaticResource SwalekhaBackgroundDark}}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Edit" Command="{Binding EditPolicyCommand}" />
    </ContentPage.ToolbarItems>

    <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy}">
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="14">

                <Border Padding="16" StrokeThickness="0" StrokeShape="RoundRectangle 14"
                              BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                              IsVisible="{Binding Policy, Converter={StaticResource NullableHasValueConverter}}">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding Policy.Insurer}" FontSize="16" FontAttributes="Bold" TextColor="{StaticResource White}" />
                        <Label Text="{Binding Policy.PolicyType}" FontSize="12" TextColor="{StaticResource SecondaryDarkText}" />
                        <Label Text="{Binding Policy.SumAssured, StringFormat='₹{0:N0} sum assured'}" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource White}" Margin="0,6,0,0"
                               IsVisible="{Binding Policy.SumAssured, Converter={StaticResource NullableHasValueConverter}}" />
                        <Label FontSize="11" TextColor="{StaticResource SecondaryDarkText}">
                            <Label.Text>
                                <MultiBinding StringFormat="Premium ₹{0:N0} · {1}">
                                    <Binding Path="Policy.PremiumAmount" />
                                    <Binding Path="Policy.PremiumFrequency" />
                                </MultiBinding>
                            </Label.Text>
                        </Label>
                        <Label Text="{Binding Policy.NextPremiumDueDate, StringFormat='Next due {0:dd MMM yyyy}'}" FontSize="11" TextColor="{StaticResource SecondaryDarkText}" />
                        <Label Text="Premium due now" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource SecondaryDarkText}"
                               IsVisible="{Binding Policy.PremiumDueNow}" />
                        <Label Text="Matured" FontSize="11" FontAttributes="Bold" TextColor="{StaticResource SecondaryDarkText}"
                               IsVisible="{Binding Policy.IsMatured}" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="{Binding ErrorMessage}"
                       IsVisible="{Binding HasError}"
                       TextColor="{StaticResource SwalekhaDanger}"
                       BackgroundColor="{StaticResource SwalekhaDangerBg}"
                       Padding="10" FontSize="13" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsVisible="{Binding CanPayPremium}">
                    <buttons:SfButton Grid.Column="0" Text="Pay premium"
                                       Command="{Binding PayPremiumCommand}"
                                       HeightRequest="42" CornerRadius="8"
                                       Background="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Secondary}}"
                                       TextColor="{StaticResource White}" />
                    <buttons:SfButton Grid.Column="1" Text="Mark matured"
                                       Command="{Binding ToggleMaturingCommand}"
                                       HeightRequest="42" CornerRadius="8"
                                       Background="Transparent"
                                       Stroke="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Secondary}}"
                                       StrokeThickness="1"
                                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Secondary}}" />
                </Grid>

                <Border Padding="14" StrokeThickness="0" StrokeShape="RoundRectangle 14"
                              IsVisible="{Binding IsMaturing}"
                              BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource SwalekhaSurfaceDark}}">
                    <VerticalStackLayout Spacing="10">
                        <inputLayout:SfTextInputLayout Hint="Maturity amount credited" ContainerType="Outlined">
                            <Entry Text="{Binding MaturityAmountText}" Keyboard="Numeric" />
                        </inputLayout:SfTextInputLayout>
                        <Label Text="If a bank account is linked, it will be credited automatically."
                               FontSize="11" TextColor="{StaticResource SwalekhaMuted}" />
                        <buttons:SfButton Text="Confirm matured"
                                           Command="{Binding ConfirmMaturedCommand}"
                                           HeightRequest="42" CornerRadius="8"
                                           Background="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Secondary}}"
                                           TextColor="{StaticResource White}" />
                    </VerticalStackLayout>
                </Border>

                <Border Padding="14" StrokeThickness="0" StrokeShape="RoundRectangle 14"
                              IsVisible="{Binding Policy.NomineeName, Converter={StaticResource NullableHasValueConverter}}"
                              BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource SwalekhaSurfaceDark}}">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Nominee" FontSize="11" TextColor="{StaticResource SwalekhaMuted}" />
                        <Label Text="{Binding Policy.NomineeName}" FontSize="13" FontAttributes="Bold" />
                        <Label Text="{Binding Policy.NomineeRelationship}" FontSize="11" TextColor="{StaticResource SwalekhaMuted}" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
