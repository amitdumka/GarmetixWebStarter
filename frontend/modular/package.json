{
  "name": "@garmetix/modular",
  "private": true,
  "version": "6.0.22",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "node scripts/validate-structure.mjs",
    "validate": "node scripts/validate-all.mjs",
    "deploy:preflight": "node scripts/deploy-preflight.mjs",
    "release:checklist": "node scripts/release-checklist.mjs",
    "smoke:checklist": "node scripts/smoke-checklist.mjs",
    "smoke:routes": "node scripts/smoke-local-routes.mjs",
    "smoke:api": "node scripts/smoke-api-auth.mjs",
    "smoke:public": "node scripts/smoke-public-report.mjs",
    "smoke:visual": "node scripts/smoke-visual-notes.mjs",
    "main:backoffice-readiness": "node scripts/main-backoffice-readiness.mjs",
    "main:backoffice-contract": "node scripts/main-backoffice-contract-check.mjs",
    "main:browser-acceptance": "node scripts/main-backoffice-browser-acceptance.mjs",
    "main:writable-readiness": "node scripts/main-writable-readiness.mjs",
    "main:stage13e-closure": "node scripts/main-stage13e-closure.mjs",
    "admin:saas-readiness": "node scripts/admin-saas-readiness.mjs",
    "admin:browser-acceptance": "node scripts/admin-browser-acceptance.mjs",
    "admin:writable-preflight": "node scripts/admin-writable-preflight.mjs",
    "admin:stage13f-closure": "node scripts/admin-stage13f-closure.mjs",
    "build:main": "npm --workspace @garmetix/main-web run build",
    "build:ai-sense": "npm --workspace @garmetix/ai-sense-web run build",
    "build:admin": "npm --workspace @garmetix/admin-web run build",
    "deploy:main": "bash deploy/main-static-deploy.sh",
    "deploy:ai-sense": "bash deploy/ai-sense-static-deploy.sh",
    "deploy:admin": "bash deploy/admin-static-deploy.sh",
    "deploy:srp": "node scripts/run-bash-script.mjs deploy/srp-whole-site-deploy.sh",
    "deploy:srp:readiness": "node scripts/run-bash-script.mjs deploy/srp-host-readiness.sh",
    "deploy:srp:runtime": "node scripts/run-bash-script.mjs deploy/srp-runtime-bootstrap.sh",
    "deploy:srp:cloudflare": "node scripts/run-bash-script.mjs deploy/srp-cloudflare-activate.sh",
    "deploy:srp:acceptance": "node scripts/srp-public-acceptance.mjs",
    "deploy:srp:backup": "node scripts/run-bash-script.mjs deploy/srp-backup-database.sh"
  },
  "overrides": {
    "@babel/generator": "8.0.0-rc.6",
    "@babel/parser": "8.0.0-rc.6",
    "@babel/types": "8.0.0-rc.6"
  },
  "devDependencies": {
    "@iconify-json/lucide": "1.2.114",
    "@nuxt/ui": "4.9.0",
    "nuxt": "4.4.8",
    "tailwindcss": "4.3.1",
    "vue": "3.5.38"
  }
}
