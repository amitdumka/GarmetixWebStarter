# Copy this file to postfix-relay.env and fill in real values. Never commit the filled-in
# file - postfix-relay.env is intentionally not tracked (see .gitignore entry added alongside
# this example). Every value here is also settable directly as a Provider in the
# Communication & Mail admin UI (Providers page) if you'd rather skip this relay entirely and
# have the application talk to Brevo directly - that is the default, recommended path; this
# relay is only for operators who specifically want a local SMTP hop.

# The Brevo SMTP username/password from Brevo > SMTP & API > SMTP tab (same credentials as
# the SMTP > Brevo preset provider you would configure in Communication & Mail > Providers).
BREVO_SMTP_USERNAME=
BREVO_SMTP_PASSWORD=

# Comma-separated CIDR ranges allowed to relay through this container. Keep this to your own
# application's internal network only - never 0.0.0.0/0.
RELAY_ALLOWED_NETWORKS=10.0.0.0/24

# The domain this relay identifies itself as (used in Postfix's myhostname/mydomain).
RELAY_MAIL_DOMAIN=relay.internal

# IP to bind the relay's port 25 to on the Docker host. Leave as 127.0.0.1 unless you have a
# specific reason to expose it more broadly - and if you do, put a firewall in front of it.
RELAY_BIND_ADDRESS=127.0.0.1
